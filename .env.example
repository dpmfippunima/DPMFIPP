# Safe to expose in the browser. RLS must remain enabled on every public table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never add this value to client-side JavaScript or commit it.
SUPABASE_SECRET_KEY=

# Required before enabling public D-DAS submission in production.
# Choose the provider and values in deployment settings; do not hard-code them.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
OTP_FROM_EMAIL=
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=

# Scheduler-only route protection.
CRON_SECRET=
